From 9836197a99fcae040b70e015d8ba17b9c9bdc499 Mon Sep 17 00:00:00 2001
From: mocoy <judsonwebdesign@gmail.com>
Date: Thu, 17 Sep 2026 20:17:43 -0600
Subject: [PATCH] drm/msm/dpu: debugfs/sysfs trigger for on-demand display
 state snapshots

Diagnostic for the X1E80100 post-suspend half-panel corruption: the
artifact leaves no kernel trace, and the diverging per-DSPP state must
be captured while it is live on screen. Writing to
/sys/bus/platform/devices/ae01000.display-controller/trigger_snapshot
fires msm_disp_snapshot_state() immediately, producing a devcoredump
of every DPU block (CTL/INTF/DSPP/SSPP/LM/pingpong) for offline
diffing of the left/right half datapath blocks.

TEMPORARY diagnostic patch - remove after the campaign.
---
 drivers/gpu/drm/msm/disp/dpu1/dpu_kms.c | 30 +++++++++++++++++++++++++
 1 file changed, 30 insertions(+)

diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_kms.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_kms.c
index da3556e..02a9612 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_kms.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_kms.c
@@ -1376,6 +1376,31 @@ static int dpu_kms_mmap_dpu(struct dpu_kms *dpu_kms)
 	return 0;
 }
 
+
+/*
+ * Debug: on-demand display state snapshot. Writing anything to this
+ * attribute triggers msm_disp_snapshot_state() for the drm device,
+ * capturing the current register state of every DPU block (CTL, INTF,
+ * DSPP, SSPP, LM, pingpong) into a devcoredump - used to diff the
+ * datapath state of the two panel halves while a corruption artifact
+ * is live on screen.
+ */
+static ssize_t trigger_snapshot_store(struct device *dev,
+				      struct device_attribute *attr,
+				      const char *buf, size_t count)
+{
+	struct msm_drm_private *priv = platform_get_drvdata(to_platform_device(dev));
+	struct dpu_kms *dpu_kms;
+
+	if (!priv || !priv->kms)
+		return -ENODEV;
+
+	dpu_kms = to_dpu_kms(priv->kms);
+	msm_disp_snapshot_state(dpu_kms->dev);
+	return count;
+}
+static DEVICE_ATTR_WO(trigger_snapshot);
+
 static int dpu_dev_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
@@ -1392,6 +1417,10 @@ static int dpu_dev_probe(struct platform_device *pdev)
 
 	dpu_kms->pdev = pdev;
 
+	ret = device_create_file(dev, &dev_attr_trigger_snapshot);
+	if (ret)
+		return ret;
+
 	ret = devm_pm_opp_set_clkname(dev, "core");
 	if (ret)
 		return ret;
@@ -1428,6 +1457,7 @@ static int dpu_dev_probe(struct platform_device *pdev)
 
 static void dpu_dev_remove(struct platform_device *pdev)
 {
+	device_remove_file(&pdev->dev, &dev_attr_trigger_snapshot);
 	component_master_del(&pdev->dev, &msm_drm_ops);
 }
 
