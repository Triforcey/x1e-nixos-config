From b65a4b502acb341a1acd32d1cfa24267ecbfddc6 Mon Sep 17 00:00:00 2001
From: mocoy <judsonwebdesign@gmail.com>
Date: Thu, 17 Sep 2026 18:27:38 -0600
Subject: [PATCH] drm/msm/dpu: read-and-restore DSPP color state on every
 commit

The volatile per-DSPP color state (the GC LUT RAM) can diverge from
software at any mdss power-domain transition - system suspend or
runtime - and a full atomic modeset does not re-program the DSPP LUT
RAM (the duplicated DRM state reports no color-management change, so
setup_cp_blocks skips it).

Instead of gating the verification on resume events, verify on every
commit: read the GC LUT back through the indexed ports, compare
against the software LUT, and repair on mismatch (bounded retries,
ratelimited logging). The PCC/GC programming loop itself remains
gated on color_mgmt_changed as upstream has it.

- dpu_hw_dspp: expose collect_gc_lut (indexed readback).
- dpu_crtc: unconditional verify-and-repair pass after the color
  programming loop in _dpu_crtc_setup_cp_blocks().
---
 drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c    | 40 +++++++++++++++++++++
 drivers/gpu/drm/msm/disp/dpu1/dpu_hw_dspp.c | 28 +++++++++++++++
 drivers/gpu/drm/msm/disp/dpu1/dpu_hw_dspp.h | 11 ++++++
 3 files changed, 79 insertions(+)

diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c
index 42d0a52..86b162d 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c
@@ -896,6 +896,46 @@ static void _dpu_crtc_setup_cp_blocks(struct drm_crtc *crtc)
 				mixer[i].hw_dspp->idx, DPU_DSPP_GC);
 		}
 	}
+
+	/*
+	 * Read-and-restore, on EVERY commit: the volatile per-DSPP color
+	 * state can diverge from software at any power-domain transition
+	 * (system suspend or runtime), and a modeset does not re-program
+	 * the DSPP LUT RAM. Read the GC LUT back through the indexed ports
+	 * and repair until it matches the software state (bounded retries).
+	 */
+	if (state->gamma_lut && cstate->num_mixers && mixer[0].hw_dspp &&
+	    mixer[0].hw_dspp->ops.collect_gc_lut) {
+		struct dpu_hw_gc_lut *expect = kzalloc_obj(*expect);
+		struct dpu_hw_gc_lut *rb = kzalloc_obj(*rb);
+
+		if (expect)
+			_dpu_crtc_get_gc_lut(state, expect);
+
+		for (i = 0; expect && rb && i < cstate->num_mixers; i++) {
+			struct dpu_hw_dspp *dspp = mixer[i].hw_dspp;
+			int a;
+
+			if (!dspp || !dspp->ops.collect_gc_lut)
+				continue;
+			for (a = 0; a < 3; a++) {
+				if (!dspp->ops.collect_gc_lut(dspp, rb) &&
+				    !memcmp(rb->c0, expect->c0, sizeof(expect->c0)) &&
+				    !memcmp(rb->c1, expect->c1, sizeof(expect->c1)) &&
+				    !memcmp(rb->c2, expect->c2, sizeof(expect->c2)))
+					break;
+				dspp->ops.setup_gc(dspp, expect);
+				pr_err_ratelimited("[dpu] dspp%d GC LUT mismatch: repaired\n",
+						   dspp->idx - DSPP_0);
+			}
+			if (a == 3)
+				DPU_ERROR("dspp%d GC LUT readback mismatch after retries\n",
+						dspp->idx - DSPP_0);
+		}
+
+		kfree(rb);
+		kfree(expect);
+	}
 }
 
 static void dpu_crtc_atomic_begin(struct drm_crtc *crtc,
diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_dspp.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_dspp.c
index 23dcbe1..7f4c0d5 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_dspp.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_dspp.c
@@ -75,6 +75,32 @@ static void dpu_setup_dspp_pcc(struct dpu_hw_dspp *ctx,
 	DPU_REG_WRITE(&ctx->hw, base, PCC_EN);
 }
 
+static int dpu_hw_dspp_collect_gc_lut(struct dpu_hw_dspp *ctx,
+		struct dpu_hw_gc_lut *gc_lut)
+{
+	u32 base;
+	int i;
+
+	if (!ctx || !gc_lut)
+		return -EINVAL;
+
+	base = ctx->cap->sblk->gc.base;
+	if (!base)
+		return -ENOENT;
+
+	DPU_REG_WRITE(&ctx->hw, base + GC_C0_INDEX_OFF, 0);
+	DPU_REG_WRITE(&ctx->hw, base + GC_C1_INDEX_OFF, 0);
+	DPU_REG_WRITE(&ctx->hw, base + GC_C2_INDEX_OFF, 0);
+
+	for (i = 0; i < PGC_TBL_LEN; i++) {
+		gc_lut->c0[i] = DPU_REG_READ(&ctx->hw, base + GC_C0_OFF);
+		gc_lut->c1[i] = DPU_REG_READ(&ctx->hw, base + GC_C1_OFF);
+		gc_lut->c2[i] = DPU_REG_READ(&ctx->hw, base + GC_C2_OFF);
+	}
+
+	return 0;
+}
+
 static void dpu_setup_dspp_gc(struct dpu_hw_dspp *ctx,
 		struct dpu_hw_gc_lut *gc_lut)
 {
@@ -146,6 +172,8 @@ struct dpu_hw_dspp *dpu_hw_dspp_init(struct drm_device *dev,
 		c->ops.setup_pcc = dpu_setup_dspp_pcc;
 	if (c->cap->sblk->gc.base)
 		c->ops.setup_gc = dpu_setup_dspp_gc;
+	if (c->cap->sblk->gc.base)
+		c->ops.collect_gc_lut = dpu_hw_dspp_collect_gc_lut;
 
 	return c;
 }
diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_dspp.h b/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_dspp.h
index b47b778..a786156 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_dspp.h
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_dspp.h
@@ -72,6 +72,17 @@ struct dpu_hw_dspp_ops {
 	 */
 	void (*setup_gc)(struct dpu_hw_dspp *ctx, struct dpu_hw_gc_lut *gc_lut);
 
+	/**
+	 * collect_gc_lut - read the GC LUT back from the DSPP hardware
+	 * @ctx: dspp ctx pointer
+	 * @gc_lut: buffer to fill with the hardware LUT contents
+	 *
+	 * Read-and-restore support: reads the volatile LUT through the
+	 * indexed GC data ports so callers can verify that programmed
+	 * color state actually landed in the hardware.
+	 */
+	int (*collect_gc_lut)(struct dpu_hw_dspp *ctx, struct dpu_hw_gc_lut *gc_lut);
+
 };
 
