From d4fe6265799a5fb028b72dbb6dfe765f85ca4393 Mon Sep 17 00:00:00 2001
From: mocoy <judsonwebdesign@gmail.com>
Date: Thu, 17 Sep 2026 21:16:55 -0600
Subject: [PATCH] drm/msm/dpu: verify-and-repair DSPP color state on every
 commit (GC + PCC)

The volatile per-DSPP color state can diverge from software at any
power-domain transition - system suspend or runtime - and a full
atomic modeset does not re-program the DSPP LUT RAM (the duplicated
DRM state reports no color-management change).

Verify on every commit:
- GC LUT: read back through the indexed ports, compare against the
  software LUT, repair on mismatch (bounded retries). The repair now
  stages the DSPP GC flush bit - without it the LUT writes stay
  shadowed and never reach the datapath.
- PCC: the two DSPPs must agree on the PCC op register. The enable bit
  is volatile across the domain collapse and has been observed latched
  on one half and cleared on the other (dspp_0 op=1, dspp_1=0, with
  otherwise identical registers - captured live with the corruption on
  screen), surfacing as per-half color distortion. On divergence both
  halves are re-programmed from the software state.
---
 drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c    | 96 +++++++++++++++++++++
 drivers/gpu/drm/msm/disp/dpu1/dpu_hw_dspp.c | 36 ++++++++
 drivers/gpu/drm/msm/disp/dpu1/dpu_hw_dspp.h | 16 ++++
 3 files changed, 148 insertions(+)

diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c
index 42d0a52..5fb6315 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c
@@ -896,6 +896,102 @@ static void _dpu_crtc_setup_cp_blocks(struct drm_crtc *crtc)
 				mixer[i].hw_dspp->idx, DPU_DSPP_GC);
 		}
 	}
+
+	/*
+	 * Read-and-restore, on EVERY commit: the volatile per-DSPP color
+	 * state can diverge from software at any power-domain transition
+	 * (system suspend or runtime), and a modeset does not re-program
+	 * the DSPP LUT RAM. Read the GC LUT back through the indexed ports
+	 * and repair until it matches the software state (bounded retries).
+	 * NOTE: the repair must stage the DSPP flush bit - without it the
+	 * LUT writes stay shadowed and never reach the datapath.
+	 */
+	if (state->gamma_lut && cstate->num_mixers && mixer[0].hw_dspp &&
+	    mixer[0].hw_dspp->ops.collect_gc_lut) {
+		struct dpu_hw_gc_lut *expect = kzalloc_obj(*expect);
+		struct dpu_hw_gc_lut *rb = kzalloc_obj(*rb);
+
+		if (expect)
+			_dpu_crtc_get_gc_lut(state, expect);
+
+		for (i = 0; expect && rb && i < cstate->num_mixers; i++) {
+			struct dpu_hw_dspp *dspp = mixer[i].hw_dspp;
+			struct dpu_hw_ctl *ctl = mixer[i].lm_ctl;
+			int a;
+
+			if (!dspp || !dspp->ops.collect_gc_lut || !ctl)
+				continue;
+			for (a = 0; a < 3; a++) {
+				if (!dspp->ops.collect_gc_lut(dspp, rb) &&
+				    !memcmp(rb->c0, expect->c0, sizeof(expect->c0)) &&
+				    !memcmp(rb->c1, expect->c1, sizeof(expect->c1)) &&
+				    !memcmp(rb->c2, expect->c2, sizeof(expect->c2)))
+					break;
+				dspp->ops.setup_gc(dspp, expect);
+				if (ctl->ops.update_pending_flush_dspp)
+					ctl->ops.update_pending_flush_dspp(ctl,
+						dspp->idx, DPU_DSPP_GC);
+				pr_err_ratelimited("[dpu] dspp%d GC LUT mismatch: repaired\n",
+						   dspp->idx - DSPP_0);
+			}
+			if (a == 3)
+				DPU_ERROR("dspp%d GC LUT readback mismatch after retries\n",
+						dspp->idx - DSPP_0);
+		}
+
+		kfree(rb);
+		kfree(expect);
+	}
+
+	/*
+	 * PCC: the two DSPPs must agree on the PCC op register. The enable
+	 * bit is volatile across the domain collapse and has been observed
+	 * latched on one half and cleared on the other (dspp_0 op=1,
+	 * dspp_1=0, with otherwise identical registers), surfacing as
+	 * per-half color distortion that neither a modeset nor the GC verify
+	 * covers. Repair both halves from the software state.
+	 */
+	{
+		u32 ops[4] = { 0, 0, 0, 0 };
+		bool checked = false, differ = false;
+		int j;
+
+		for (i = 0; i < cstate->num_mixers && i < 4; i++) {
+			struct dpu_hw_dspp *dspp = mixer[i].hw_dspp;
+
+			if (!dspp || !dspp->ops.collect_pcc)
+				continue;
+			ops[i] = dspp->ops.collect_pcc(dspp);
+			checked = true;
+		}
+		for (j = 1; j < cstate->num_mixers && j < 4; j++)
+			if (ops[j] != ops[0])
+				differ = true;
+
+		if (checked && differ) {
+			struct dpu_hw_pcc_cfg cfg;
+			bool have_cfg = false;
+
+			if (state->ctm) {
+				_dpu_crtc_get_pcc_coeff(state, &cfg);
+				have_cfg = true;
+			}
+
+			for (i = 0; i < cstate->num_mixers; i++) {
+				struct dpu_hw_dspp *dspp = mixer[i].hw_dspp;
+				struct dpu_hw_ctl *ctl = mixer[i].lm_ctl;
+
+				if (!dspp || !dspp->ops.setup_pcc || !ctl)
+					continue;
+				dspp->ops.setup_pcc(dspp, have_cfg ? &cfg : NULL);
+				if (ctl->ops.update_pending_flush_dspp)
+					ctl->ops.update_pending_flush_dspp(ctl,
+						dspp->idx, DPU_DSPP_PCC);
+				pr_err_ratelimited("[dpu] dspp%d PCC op mismatch: repaired\n",
+						   dspp->idx - DSPP_0);
+			}
+		}
+	}
 }
 
 static void dpu_crtc_atomic_begin(struct drm_crtc *crtc,
diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_dspp.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_dspp.c
index 23dcbe1..eb4ece3 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_dspp.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_dspp.c
@@ -75,6 +75,40 @@ static void dpu_setup_dspp_pcc(struct dpu_hw_dspp *ctx,
 	DPU_REG_WRITE(&ctx->hw, base, PCC_EN);
 }
 
+static int dpu_hw_dspp_collect_gc_lut(struct dpu_hw_dspp *ctx,
+		struct dpu_hw_gc_lut *gc_lut)
+{
+	u32 base;
+	int i;
+
+	if (!ctx || !gc_lut)
+		return -EINVAL;
+
+	base = ctx->cap->sblk->gc.base;
+	if (!base)
+		return -ENOENT;
+
+	DPU_REG_WRITE(&ctx->hw, base + GC_C0_INDEX_OFF, 0);
+	DPU_REG_WRITE(&ctx->hw, base + GC_C1_INDEX_OFF, 0);
+	DPU_REG_WRITE(&ctx->hw, base + GC_C2_INDEX_OFF, 0);
+
+	for (i = 0; i < PGC_TBL_LEN; i++) {
+		gc_lut->c0[i] = DPU_REG_READ(&ctx->hw, base + GC_C0_OFF);
+		gc_lut->c1[i] = DPU_REG_READ(&ctx->hw, base + GC_C1_OFF);
+		gc_lut->c2[i] = DPU_REG_READ(&ctx->hw, base + GC_C2_OFF);
+	}
+
+	return 0;
+}
+
+static u32 dpu_hw_dspp_collect_pcc(struct dpu_hw_dspp *ctx)
+{
+	if (!ctx || !ctx->cap->sblk->pcc.base)
+		return 0;
+
+	return DPU_REG_READ(&ctx->hw, ctx->cap->sblk->pcc.base);
+}
+
 static void dpu_setup_dspp_gc(struct dpu_hw_dspp *ctx,
 		struct dpu_hw_gc_lut *gc_lut)
 {
@@ -146,6 +180,8 @@ struct dpu_hw_dspp *dpu_hw_dspp_init(struct drm_device *dev,
 		c->ops.setup_pcc = dpu_setup_dspp_pcc;
 	if (c->cap->sblk->gc.base)
 		c->ops.setup_gc = dpu_setup_dspp_gc;
+	if (c->cap->sblk->pcc.base)
+		c->ops.collect_pcc = dpu_hw_dspp_collect_pcc;
 
 	return c;
 }
diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_dspp.h b/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_dspp.h
index b47b778..db72fb5 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_dspp.h
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_dspp.h
@@ -72,6 +72,22 @@ struct dpu_hw_dspp_ops {
 	 */
 	void (*setup_gc)(struct dpu_hw_dspp *ctx, struct dpu_hw_gc_lut *gc_lut);
 
+	/**
+	 * collect_gc_lut - read the GC LUT back from the DSPP hardware
+	 * @ctx: dspp ctx pointer
+	 * @gc_lut: buffer to fill with the hardware LUT contents
+	 */
+	int (*collect_gc_lut)(struct dpu_hw_dspp *ctx, struct dpu_hw_gc_lut *gc_lut);
+
+	/**
+	 * collect_pcc - read the PCC op register from the DSPP hardware
+	 * @ctx: dspp ctx pointer
+	 *
+	 * Returns the PCC op/enable register so callers can verify that both
+	 * halves' color-correction blocks agree with the software state.
+	 */
+	u32 (*collect_pcc)(struct dpu_hw_dspp *ctx);
+
 };
 
 /**
